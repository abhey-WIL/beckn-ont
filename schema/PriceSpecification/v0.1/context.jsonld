{
  "@context": {
    "schema": "https://schema.org/",
    "beckn": "https://schema.beckn.io/",
    "ps": "https://schema.beckn.io/PriceSpecification#",
    "PriceSpecification": "ps:PriceSpecification",
    "price": {
      "@id": "ps:price"
    },
    "priceCurrency": {
      "@id": "ps:priceCurrency"
    },
    "description": {
      "@id": "ps:description"
    },
    "valueAddedTaxIncluded": {
      "@id": "ps:valueAddedTaxIncluded"
    },
    "nightlyRate": {
      "@id": "ps:nightlyRate"
    },
    "paymentSchedule": {
      "@id": "ps:paymentSchedule"
    },
    "acceptedPaymentMethods": {
      "@id": "ps:acceptedPaymentMethods"
    },
    "selectedPaymentMethod": {
      "@id": "ps:selectedPaymentMethod"
    },
    "paymentGatewayUrl": {
      "@id": "ps:paymentGatewayUrl"
    },
    "paymentReference": {
      "@id": "ps:paymentReference"
    },
    "paymentDeadline": {
      "@id": "ps:paymentDeadline"
    },
    "transactionRef": {
      "@id": "ps:transactionRef"
    },
    "paymentAuthorisation": {
      "@id": "ps:paymentAuthorisation"
    },
    "settled": {
      "@id": "ps:settled"
    },
    "escrowStatus": {
      "@id": "ps:escrowStatus"
    },
    "escrowReference": {
      "@id": "ps:escrowReference"
    },
    "cancellationCharge": {
      "@id": "ps:cancellationCharge"
    },
    "refundAmount": {
      "@id": "ps:refundAmount"
    },
    "refundTimeline": {
      "@id": "ps:refundTimeline"
    }
  }
}