{
  "@context": {
    "schema": "https://schema.org/",
    "beckn": "https://schema.beckn.io/",
    "hr": "https://schema.beckn.io/HotelResource#",
    "HotelResource": "hr:HotelResource",
    "name": {
      "@id": "hr:name"
    },
    "roomCategory": {
      "@id": "hr:roomCategory"
    },
    "bedType": {
      "@id": "hr:bedType"
    },
    "maxOccupancy": {
      "@id": "hr:maxOccupancy"
    },
    "roomAmenities": {
      "@id": "hr:roomAmenities"
    },
    "images": {
      "@id": "hr:images"
    },
    "hotelId": {
      "@id": "hr:hotelId"
    },
    "staticId": {
      "@id": "hr:staticId"
    },
    "hotelName": {
      "@id": "hr:hotelName"
    },
    "starRating": {
      "@id": "hr:starRating"
    },
    "hotelAmenities": {
      "@id": "hr:hotelAmenities"
    }
  }
}
