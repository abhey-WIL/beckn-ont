{
  "@context": {
    "schema": "https://schema.org/",
    "beckn": "https://schema.beckn.io/",
    "hsi": "https://schema.beckn.io/HotelSearchIntent#",
    "HotelSearchIntent": "hsi:HotelSearchIntent",
    "searchSession": {
      "@id": "hsi:searchSession"
    },
    "stay": {
      "@id": "hsi:stay"
    },
    "rooms": {
      "@id": "hsi:rooms"
    },
    "nationality": {
      "@id": "hsi:nationality"
    },
    "countryOfResidence": {
      "@id": "hsi:countryOfResidence"
    },
    "currency": {
      "@id": "hsi:currency"
    }
  }
}